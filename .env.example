# TickTick is read from its official MCP server by a cron route. OAuth client
# credentials and tokens live in the integration_tokens DB table (Vercel has no
# persistent disk), seeded from scripts/ticktick-mcp-spike.ts — not here.
TICKTICK_MCP_SERVER_URL=
# Entries starting before this date are ignored (YYYY-MM-DD)
TICKTICK_CUTOVER_DATE=
# How many days back each sync reconciles; default 7
TICKTICK_LOOKBACK_DAYS=

# Database
DATABASE_URL=

# Google Calendar OAuth (create at https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public app URL for calendar push notifications (e.g. https://your-app.vercel.app). Vercel sets VERCEL_URL automatically.
APP_URL=

# Microsoft Graph OAuth (register app at https://portal.azure.com → App registrations)
# (Optional — only needed if using Microsoft Graph directly)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=organizations

# Vercel Cron secret (set in Vercel dashboard; Vercel sends it as Authorization: Bearer <CRON_SECRET>)
# To change poll cadence: edit "schedule" in vercel.json
#   Every 1 min (testing): "* * * * *"
#   Every 5 min (production): "*/5 * * * *"
CRON_SECRET=

# Power Automate ingest webhook secret (shared secret for calendar event ingestion)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Optional: session/auth signing (e.g. for future auth)
NEXTAUTH_SECRET=
