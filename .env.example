# TickTick is read over the MCP connector by a scheduled Claude session, which
# POSTs batches to /api/ingest/ticktick using INGEST_SECRET below. The app itself
# holds no TickTick credentials, so no TickTick OAuth vars are required.

# Database
DATABASE_URL=

# Google Calendar OAuth (create at https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public app URL for calendar push notifications (e.g. https://your-app.vercel.app). Vercel sets VERCEL_URL automatically.
APP_URL=

# Microsoft Graph OAuth (register app at https://portal.azure.com → App registrations)
# (Optional — only needed if using Microsoft Graph directly)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=organizations

# Vercel Cron secret (set in Vercel dashboard; Vercel sends it as Authorization: Bearer <CRON_SECRET>)
# To change poll cadence: edit "schedule" in vercel.json
#   Every 1 min (testing): "* * * * *"
#   Every 5 min (production): "*/5 * * * *"
CRON_SECRET=

# Shared secret for ingest endpoints (TickTick batches via /api/ingest/ticktick,
# and Power Automate calendar ingestion). Required for TickTick polling to work.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Optional: session/auth signing (e.g. for future auth)
NEXTAUTH_SECRET=
